# ── Database ──────────────────────────────────────────────
# Neon free tier: postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.us-east-2.aws.neon.tech/busconductor?sslmode=require

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_REFRESH_SECRET_KEY=change-me-to-yet-another-random-string

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for dev)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Google OAuth (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (optional — Brevo SMTP for password reset) ─────
BRAVO_API_KEY=your-brevo-api-key
SMTP_USER=your-brevo-email@example.com
SMTP_PASS=your-brevo-smtp-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=BusConductor
